{
 "name": "milo.",
 "short_name": "milo.",
 "description": "My Music, My Way. A music player with adaptive backgrounds, synced lyrics and live radio.",
 "id": "./",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#000000",
 "theme_color": "#000000",
 "categories": [
  "music",
  "entertainment"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "shortcuts": [
  {
   "name": "Search",
   "url": "./index.html#search",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ],
   "short_name": "Search",
   "description": "Open Search"
  },
  {
   "name": "Discover",
   "url": "./index.html#discover",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ],
   "short_name": "Discover",
   "description": "Open Discover"
  },
  {
   "name": "Library",
   "url": "./index.html#library",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ],
   "short_name": "Library",
   "description": "Open Library"
  },
  {
   "name": "Messages",
   "short_name": "Messages",
   "description": "Open your chats",
   "url": "./index.html#messages",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "audio/*": [
     ".mp3",
     ".m4a",
     ".aac",
     ".flac",
     ".wav",
     ".ogg",
     ".opus"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "navigate-existing"
 },
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "audio",
     "accept": [
      "audio/*",
      ".mp3",
      ".m4a",
      ".aac",
      ".flac",
      ".wav",
      ".ogg",
      ".opus"
     ]
    }
   ]
  }
 },
 "lang": "en",
 "dir": "ltr",
 "display_override": [
  "window-controls-overlay",
  "standalone",
  "minimal-ui"
 ],
 "prefer_related_applications": false,
 "related_applications": [],
 "handle_links": "preferred",
 "screenshots": [
  {
   "src": "screenshots/wide-home.png",
   "sizes": "1280x720",
   "type": "image/png",
   "label": "Home",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/wide-discover.png",
   "sizes": "1280x720",
   "type": "image/png",
   "label": "Discover free music",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/wide-library.png",
   "sizes": "1280x720",
   "type": "image/png",
   "label": "Library",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/wide-playing.png",
   "sizes": "1280x720",
   "type": "image/png",
   "label": "Now playing",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/narrow-home.png",
   "sizes": "720x1280",
   "type": "image/png",
   "label": "Home",
   "form_factor": "narrow"
  },
  {
   "src": "screenshots/narrow-discover.png",
   "sizes": "720x1280",
   "type": "image/png",
   "label": "Discover free music",
   "form_factor": "narrow"
  },
  {
   "src": "screenshots/narrow-library.png",
   "sizes": "720x1280",
   "type": "image/png",
   "label": "Library",
   "form_factor": "narrow"
  },
  {
   "src": "screenshots/narrow-playing.png",
   "sizes": "720x1280",
   "type": "image/png",
   "label": "Now playing",
   "form_factor": "narrow"
  }
 ]
}